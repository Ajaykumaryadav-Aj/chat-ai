# ==============================================================================
# AI Studio — Environment Configuration Template
# ==============================================================================
# Duplicate this file as `.env` in the root directory:
#   cp .env.example .env
#
# Obtain a free Gemini API key from Google AI Studio:
#   https://aistudio.google.com/app/apikey
# ==============================================================================

# Google Gemini API Key (Required)
# Use EXPO_PUBLIC_ prefix so Expo inlines the variable in client builds
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# App Environment ('development' | 'production')
APP_ENV=development
EXPO_PUBLIC_APP_ENV=development

# Gemini API Endpoint & Model Configuration (Optional overrides)
# EXPO_PUBLIC_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EXPO_PUBLIC_GEMINI_MODEL=gemini-2.5-flash
